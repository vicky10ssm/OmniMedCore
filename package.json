{
  "name": "diagbill",
  "private": true,
  "version": "0.22.0",
  "description": "OmniMed Core — modular billing and care operations for diagnostic centres, pharmacies and small hospitals",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:monitor": "tsc --noEmit && vite build --mode monitor --outDir dist-monitor",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:info": "tauri info",
    "typecheck": "tsc --noEmit",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:scope": "node scripts/check-tenant-scope.mjs",
    "check": "npm run typecheck && npm run check:migrations && npm run check:scope",
    "license:keygen": "node license-portal/generate-keys.mjs",
    "license:portal": "node license-portal/server.mjs",
    "postinstall": "node scripts/copy-wasm.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
