# Central PostgreSQL database
DATABASE_URL=postgresql://user:password@host:5432/medicore
# Set to "false" only for a local database without TLS
DATABASE_SSL=true

# Bearer token used by the Tauri terminal when POSTing /api/sync/push
SYNC_INGEST_TOKEN=replace-with-a-long-random-token

# Optional browser origin allowed to call the sync API; use the exact Tauri/app origin if not "*"
SYNC_ALLOWED_ORIGIN=*

# Read-only dashboard HTTP Basic authentication
DASHBOARD_USER=owner
DASHBOARD_PASSWORD=replace-with-a-long-random-password

# Default tenant shown when ?tenant= is absent
DEFAULT_TENANT_ID=tenant-default
