# Vendor licence portal configuration template.
#
# The server reads process environment variables; it does not automatically load this file.
# Set these in the PowerShell session before starting the portal.
#
# PowerShell:
#   $env:MEDICORE_PORTAL_ADMIN_TOKEN = "use-a-long-random-secret"
#   $env:MEDICORE_PORTAL_PORT = "8787"
#   npm run license:portal

MEDICORE_PORTAL_ADMIN_TOKEN=replace-with-a-long-random-secret
MEDICORE_PORTAL_PORT=8787
